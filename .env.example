# Nika Business media storage
# Keep MEDIA_BACKEND=local until the R2 bucket/token/domain are ready.
MEDIA_BACKEND=local
MEDIA_ALLOW_LOCAL_FALLBACK=true
MEDIA_MAX_UPLOAD_MB=15
MEDIA_MAX_IMAGE_SIDE=1800
MEDIA_WEBP_QUALITY=84

# Cloudflare R2 (use a separate bucket/token for Nika Business)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nika-business-media
# Recommended: a custom/public domain, e.g. https://media.nikabusiness.com
R2_PUBLIC_BASE_URL=
