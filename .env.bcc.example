# Режим BCC: sandbox, test или production
BCC_ENVIRONMENT=sandbox

# «Ключ API» и «Пароль API» из приложения Nika Business CRM на портале BCC
BCC_CLIENT_ID=PASTE_API_KEY_HERE
BCC_CLIENT_SECRET=PASTE_API_PASSWORD_HERE

# Fernet-ключ для шифрования клиентских токенов в PostgreSQL
BCC_TOKEN_ENCRYPTION_KEY=GENERATE_A_NEW_FERNET_KEY

# Должен полностью совпадать с URL в приложении на портале BCC
BCC_CALLBACK_URL=https://nikabusiness.com/api/integrations/bcc/callback

# Официальные scope BCC. Обычно менять их не требуется.
BCC_APP_SCOPE=bcc.application.business.account.management
BCC_CLIENT_SCOPE=oapi.business.account.api

BCC_HTTP_TIMEOUT=30
